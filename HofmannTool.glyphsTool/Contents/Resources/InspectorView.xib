<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24412" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24412"/>
        <capability name="System colors introduced in macOS 10.14" minToolsVersion="10.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="HofmannTool">
            <connections>
                <outlet property="applyButton" destination="applyButton" id="out-apply"/>
                <outlet property="clearButton" destination="clearButton" id="out-clear"/>
                <outlet property="colsLabel" destination="labelCols" id="out-label-cols"/>
                <outlet property="colsTextField" destination="colsField" id="out-cols"/>
                <outlet property="diameterLabel" destination="labelDiameter" id="out-label-diameter"/>
                <outlet property="diameterTextField" destination="diameterField" id="out-diameter"/>
                <outlet property="inspectorDialog" destination="inspectorView" id="out-dialog"/>
                <outlet property="inspectorDialogView" destination="inspectorView" id="out-dialog-view"/>
                <outlet property="outputModeSegmentedControl" destination="outputMode" id="out-output"/>
                <outlet property="rowsLabel" destination="labelRows" id="out-label-rows"/>
                <outlet property="rowsTextField" destination="rowsField" id="out-rows"/>
                <outlet property="spacingLabel" destination="labelSpacing" id="out-label-spacing"/>
                <outlet property="spacingTextField" destination="spacingField" id="out-spacing"/>
                <outlet property="xOffsetLabel" destination="labelXOffset" id="out-label-xoffset"/>
                <outlet property="xOffsetTextField" destination="xOffsetField" id="out-xoffset"/>
                <outlet property="yOffsetLabel" destination="labelYOffset" id="out-label-yoffset"/>
                <outlet property="yOffsetTextField" destination="yOffsetField" id="out-yoffset"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="inspectorView" customClass="HofmannToolInspectorView" translatesAutoresizingMaskIntoConstraints="NO">
            <rect key="frame" x="0.0" y="0.0" width="326" height="96"/>
            <subviews>
                <textField id="labelRows" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="8" y="68" width="16" height="17"/>
                    <textFieldCell key="cell" controlSize="small" title="R" id="cell-labelRows">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                </textField>
                <textField id="rowsField" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="25" y="65" width="36" height="22"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" alignment="right" title="4" drawsBackground="YES" id="cell-rowsField">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                    <connections>
                        <action selector="handleSettingsAction:" target="-2" id="act-rows"/>
                    </connections>
                </textField>
                <textField id="labelCols" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="68" y="68" width="16" height="17"/>
                    <textFieldCell key="cell" controlSize="small" title="C" id="cell-labelCols">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                </textField>
                <textField id="colsField" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="85" y="65" width="36" height="22"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" alignment="right" title="4" drawsBackground="YES" id="cell-colsField">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                    <connections>
                        <action selector="handleSettingsAction:" target="-2" id="act-cols"/>
                    </connections>
                </textField>
                <textField id="labelSpacing" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="130" y="68" width="46" height="17"/>
                    <textFieldCell key="cell" controlSize="small" title="Spacing" id="cell-labelSpacing">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                </textField>
                <textField id="spacingField" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="176" y="65" width="50" height="22"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" alignment="right" title="120" drawsBackground="YES" id="cell-spacingField">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                    <connections>
                        <action selector="handleSettingsAction:" target="-2" id="act-spacing"/>
                    </connections>
                </textField>
                <textField id="labelDiameter" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="236" y="68" width="30" height="17"/>
                    <textFieldCell key="cell" controlSize="small" title="Dia" id="cell-labelDiameter">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                </textField>
                <textField id="diameterField" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="270" y="65" width="50" height="22"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" alignment="right" title="80" drawsBackground="YES" id="cell-diameterField">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                    <connections>
                        <action selector="handleSettingsAction:" target="-2" id="act-diameter"/>
                    </connections>
                </textField>
                <textField id="labelXOffset" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="8" y="39" width="14" height="17"/>
                    <textFieldCell key="cell" controlSize="small" title="X" id="cell-labelXOffset">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                </textField>
                <textField id="xOffsetField" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="26" y="36" width="48" height="22"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" alignment="right" title="0" drawsBackground="YES" id="cell-xOffsetField">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                    <connections>
                        <action selector="handleSettingsAction:" target="-2" id="act-xoffset"/>
                    </connections>
                </textField>
                <textField id="labelYOffset" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="82" y="39" width="14" height="17"/>
                    <textFieldCell key="cell" controlSize="small" title="Y" id="cell-labelYOffset">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                </textField>
                <textField id="yOffsetField" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="100" y="36" width="48" height="22"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" alignment="right" title="0" drawsBackground="YES" id="cell-yOffsetField">
                        <font key="font" metaFont="smallSystem"/>
                    </textFieldCell>
                    <connections>
                        <action selector="handleSettingsAction:" target="-2" id="act-yoffset"/>
                    </connections>
                </textField>
                <segmentedControl id="outputMode" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="180" y="35" width="140" height="24"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" segmentDistribution="fillEqually" style="roundRect" trackingMode="selectOne" id="cell-outputMode">
                        <font key="font" metaFont="smallSystem"/>
                        <segments>
                            <segment label="Filled" selected="YES"/>
                            <segment label="Line" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="handleSettingsAction:" target="-2" id="act-output"/>
                    </connections>
                </segmentedControl>
                <button id="applyButton" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="8" y="4" width="151" height="28"/>
                    <buttonCell key="cell" type="push" title="Apply" bezelStyle="rounded" alignment="center" id="cell-applyButton">
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="applyAction:" target="-2" id="act-apply"/>
                    </connections>
                </button>
                <button id="clearButton" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO">
                    <rect key="frame" x="167" y="4" width="151" height="28"/>
                    <buttonCell key="cell" type="push" title="Clear" bezelStyle="rounded" alignment="center" id="cell-clearButton">
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="clearAction:" target="-2" id="act-clear"/>
                    </connections>
                </button>
            </subviews>
            <constraints>
                <constraint firstAttribute="width" constant="326" id="hof-width"/>
                <constraint firstAttribute="height" constant="96" id="hof-height"/>
            </constraints>
        </customView>
    </objects>
</document>
